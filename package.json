{
  "name": "personal-portfolio-information-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "db:backup": "tsx src/cli/database-backup.ts",
    "db:restore": "tsx src/cli/database-restore.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "cheerio": "^1.1.2",
    "fast-xml-parser": "^5.2.5",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
